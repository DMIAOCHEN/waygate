{
  "name": "@waygate/root",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "tsx scripts/mutation-check.ts",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "check:versions": "tsx scripts/check-versions.ts",
    "gate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:boundaries && pnpm check:versions && pnpm test:coverage"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "lefthook": "2.1.17",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
